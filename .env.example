# DeepSeek (OpenAI-compatible) credentials -- copy this file to .env
# .env is listed in .gitignore, so the key never enters version control.
# NEVER put a real key in this template file.
#
# Models available on https://api.deepseek.com (2025-11): deepseek-flash,
# deepseek-v4-pro.  deepseek-chat is NOT served by this endpoint.
# deepseek-flash is a reasoning model: run.py sends thinking={"type":"disabled"}
# by default, otherwise the whole output budget goes to reasoning and the
# returned `content` is empty.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
